# Соломон — переменные окружения.
#
# Скопируйте этот файл в `.env` и заполните значения. Настоящий `.env` в
# репозиторий не попадает (см. `.gitignore`), здесь значений нет и не бывает.
# Файл один на все части проекта: бот читает его при запуске, Vite — при сборке.

# --- Бот (Python, работает на компьютере владельца) ---

# Токен от @BotFather. Секрет: наружу не отдаётся никогда.
TELEGRAM_BOT_TOKEN=

# Telegram-id владельца. Сообщения от других id бот не обрабатывает.
OWNER_TELEGRAM_ID=

# Часовой пояс владельца — название IANA, например Asia/Yekaterinburg.
# Без него «в пятницу» не превратить в дату: пояс уходит модели вместе с
# сегодняшней датой (techspec/05-ai.md §5.1).
OWNER_TIMEZONE=

# Адрес проекта Supabase, вида https://<ref>.supabase.co
SUPABASE_URL=

# Ключ service-role. Секрет: живёт только в окружении бота, в сборку Mini App
# не попадает никогда.
SUPABASE_SERVICE_ROLE_KEY=

# Ключ Claude: им бот разбирает поручения. Секрет, тратит деньги — наружу
# не отдаётся никогда.
ANTHROPIC_API_KEY=

# Необязательный адрес API Claude. Пусто — бот ходит в api.anthropic.com;
# задан — в посредника (владелец работает через agenthello.ai, российские
# карты консоль Anthropic не принимает).
ANTHROPIC_BASE_URL=

# Ключ Deepgram: им бот распознаёт голосовые и кружки (techspec/09-voice.md).
# Секрет, тратит деньги — наружу не отдаётся никогда.
DEEPGRAM_API_KEY=

# --- Mini App (Vite вшивает VITE_* в статическую сборку) ---
#
# Ровно две переменные, и обе публичные по замыслу Supabase: данные защищает
# не ключ, а правила доступа на стороне базы.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Edge Function telegram-auth ---
#
# Эти значения задаются не здесь, а секретами проекта Supabase:
#
#   supabase secrets set TELEGRAM_BOT_TOKEN=... OWNER_TELEGRAM_ID=... \
#     JWT_SIGNING_SECRET=...
#
# JWT_SIGNING_SECRET — «JWT secret» из настроек проекта (Settings → JWT Keys → Legacy JWT Secret; имя без префикса SUPABASE_ — такие имена Supabase в секретах не принимает).
